# ===========================================================================
# Kredensial & endpoint token OAuth2 BKN
# ===========================================================================
BKN_HOST=https://apimws.bkn.go.id
BKN_TOKEN_PATH=/oauth2/token
# URL token yang dipercaya server. Biarkan kosong untuk BKN_HOST + BKN_TOKEN_PATH.
# Wajib HTTPS; nilai pada form harus sama persis dengan URL ini.
BKN_TOKEN_URL=
# Host API Gateway SIASN BKN (port 8243 pada apimws.bkn.go.id untuk /apisiasn/*).
BKN_API_HOST=https://apimws.bkn.go.id:8243
# Path & URL endpoint Data Utama PNS SIASN BKN (parameter {nip} diisi otomatis).
BKN_DATA_UTAMA_PATH=/apisiasn/1.0/pns/data-utama
# URL Data Utama yang dipercaya server. Biarkan kosong untuk BKN_API_HOST + BKN_DATA_UTAMA_PATH.
# Wajib HTTPS; mendukung placeholder {nip} atau NIP ditambahkan di akhir path.
BKN_DATA_UTAMA_URL=
BKN_GRANT_TYPE=client_credentials
TIMEOUT=30

# ===========================================================================
# Keamanan & server PHP
# ===========================================================================
# Wajib diisi bila aplikasi dibuka ke jaringan selain loopback (127.0.0.1/localhost).
APP_BASIC_USER=
APP_BASIC_PASSWORD=

# Daftar host yang diizinkan (validasi header Host, cegah DNS rebinding).
APP_TRUSTED_HOSTS=127.0.0.1,localhost,::1

# Isi 1 hanya bila berjalan di belakang reverse proxy tepercaya.
TRUST_PROXY=0

# Set 1 bila aplikasi dilayani via HTTPS, agar cookie CSRF ditandai Secure.
COOKIE_SECURE=0

# Rate limit endpoint test-token/login (brute-force protection).
# Maks percobaan per jendela waktu (detik). Isi 0 untuk menonaktifkan.
LOGIN_RATE_MAX=10
LOGIN_RATE_WINDOW=60
